# Copy to .env.deploy. This file contains no AWS credentials or Google secret value.
AWS_PROFILE=application-tracker-bootstrap
AWS_REGION=us-east-1
STACK_NAME=app-tracker-dev
BUDGET_EMAIL=you@example.com
GOOGLE_SECRET_NAME=app-tracker/dev/google-oauth
GMAIL_SECRET_NAME=app-tracker/dev/gmail-oauth

# Optional BYOK AI model IDs. Leave blank (or delete) to keep that provider
# unavailable. Use the exact model ID your provider account can call.
OPENAI_MODEL_ID=
ANTHROPIC_MODEL_ID=
GEMINI_MODEL_ID=
